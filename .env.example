# ==============================================================================
# GADAP Fiscal Core - Configurações de Ambiente (.env.example)
# ==============================================================================

# Identificação da Aplicação
APP_NAME="GADAP Fiscal Core"
APP_VERSION="0.1.0"
DEBUG=true

# Ambiente SEFAZ: 'homologacao' (tpAmb=2) ou 'producao' (tpAmb=1)
DFE_ENVIRONMENT=homologacao

# Emitente Simples Nacional (CRT 1)
EMITENTE_CNPJ=00000000000191
EMITENTE_IE=123456789110
EMITENTE_UF=SP
EMITENTE_CRT=1

# Certificado Digital ICP-Brasil A1 (.pfx / .p12)
CERTIFICATE_PATH=
CERTIFICATE_BASE64=
CERTIFICATE_PASSWORD=

# Parâmetros NFC-e (CSC)
CSC_HOMOLOGACAO_ID=000001
CSC_HOMOLOGACAO_TOKEN=0123456789ABCDEF
CSC_PRODUCAO_ID=
CSC_PRODUCAO_TOKEN=

# Variáveis de Integração Frontend (Next.js / GADAP Fiscal Hub)
NEXT_PUBLIC_API_URL=https://gadap-fiscal-core.vercel.app
NEXT_PUBLIC_APP_NAME="GADAP Fiscal Hub"
NEXT_PUBLIC_DFE_ENVIRONMENT=homologacao
NEXT_PUBLIC_API_TIMEOUT=30000
